      "idempotency_key",
      "policy_version"
    ],
    "conditional": [
      "content_id",
      "chapter_id",
      "section_id",
      "concept_ids",
      "source_ids",
      "attempt_id",
      "activity_id"
    ],
    "rules": {
      "user_id": "Derivado exclusivamente da sessão verificada no servidor.",
      "event_type": "Deve pertencer à allow-list desta versão.",
      "idempotency_key": "Única por evento semântico premiável.",
      "metadata": "Mínima, estruturada e sem segredo, e-mail ou texto livre desnecessário.",
      "blockedContent": "Falha fechada quando a elegibilidade editorial não puder ser comprovada."
    }
  },
  "eventTypes": [
