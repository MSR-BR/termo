{
  "contractId": "adaptive-learning-gamification-events",
  "version": "1.0.0",
  "status": "baseline",
  "language": "internal-identifiers-en",
  "purpose": "Contrato compartilhado e independente de produto para eventos de aprendizagem verificados.",
  "eventEnvelope": {
    "required": [
      "event_id",
      "user_id",
      "event_type",
      "occurred_at",
