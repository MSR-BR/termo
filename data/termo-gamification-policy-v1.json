    {
      "key": "eligible_section_completion",
      "sharedEventType": "section_completed",
      "points": 20,
      "repeatPolicy": "once_per_user_section",
      "requiresIdempotency": true
    },
    {
      "key": "first_chapter_assessment",
      "sharedEventType": "assessment_completed",
      "points": 30,
      "repeatPolicy": "once_per_user_chapter",
      "requiresIdempotency": true
    },
    {
      "key": "guided_review_completion",
      "sharedEventType": "assessment_reviewed",
      "points": 10,
      "repeatPolicy": "once_per_verified_review_activity",
      "requiresIdempotency": true
    },
    {
      "key": "focused_retry_completion",
      "sharedEventType": "assessment_retry_completed",
      "points": 10,
      "repeatPolicy": "once_per_verified_retry_activity",
      "requiresIdempotency": true
    },
    {
      "key": "chapter_mastery_milestone",
      "sharedEventType": "concept_mastery_reached",
      "points": 80,
      "repeatPolicy": "once_per_user_chapter_policy_version",
      "requiresIdempotency": true
    }
  ],
  "nonRewardedEvents": [
    "daily_return",
    "simulator_opened",
    "mechanic_exposed",
    "page_view",
    "scroll",
    "refresh"
  ],
  "mastery": {
    "minimumIndependentRetrievals": 2,
    "minimumDistinctSessions": 2,
    "minimumDistinctRepresentationsWhenApplicable": 2,
    "singleAssessmentThresholdIsSufficient": false,
    "helpedOrRevealedAnswerCountsAsIndependent": false
