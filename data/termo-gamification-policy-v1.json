    {
      "key": "guided_review_completion",
      "sharedEventType": "assessment_reviewed",
      "points": 10,
      "repeatPolicy": "once_per_verified_review_activity",
      "requiresIdempotency": true
    },
    {
      "key": "focused_retry_completion",
      "sharedEventType": "assessment_retry_completed",
      "points": 10,
      "repeatPolicy": "once_per_verified_retry_activity",
      "requiresIdempotency": true
    },
    {
      "key": "daily_challenge_correct",
      "sharedEventType": "daily_challenge_completed",
      "points": 10,
      "repeatPolicy": "once_per_user_utc_day",
      "requiresIdempotency": true
    }
  ],
  "nonRewardedEvents": [
    "daily_return",
    "simulator_opened",
    "mechanic_exposed",
    "page_view",
    "scroll",
    "refresh"
  ],
  "attemptModes": {
    "full_quiz": "avaliacao completa com recuperacao sem ajuda",
    "guided_review": "retomada orientada; nunca declara dominio",
    "focused_retry": "transferencia proxima apos revisao",
    "daily_challenge": "pratica curta diaria; separada da retomada orientada"
  },
  "mastery": {
    "minimumIndependentRetrievals": 2,
    "minimumDistinctSessions": 2,
    "minimumDistinctRepresentationsWhenApplicable": 2,
    "singleAssessmentThresholdIsSufficient": false,
    "helpedOrRevealedAnswerCountsAsIndependent": false
  },
