    {
      "key": "eligible_section_completion",
      "sharedEventType": "section_completed",
      "points": 20,
      "repeatPolicy": "once_per_user_section",
      "requiresIdempotency": true
    },
    {
      "key": "first_chapter_assessment",
      "sharedEventType": "assessment_completed",
      "points": 30,
      "repeatPolicy": "once_per_user_chapter",
      "requiresIdempotency": true
