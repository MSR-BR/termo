  "researchPlan": {
    "primaryQuestion": "Após exposição fiel aos modos adaptativos, há melhora em recuperação independente tardia e em forma alterada?",
    "baseline": {
      "required": true,
      "status": "not_collected",
      "minimum": "pré-teste ou primeira tentativa comparável anterior à intervenção"
    },
    "retention": {
      "required": true,
      "status": "not_collected",
      "minimumDelayDays": 7,
      "outcome": "proporção de respostas corretas, independentes e sem solução revelada"
    },
    "transfer": {
      "required": true,
      "status": "not_collected",
      "minimum": "mesmo conceito em enunciado, números ou representação alterados"
    },
    "reportingRequired": [
      "amostra e critérios de inclusão",
      "exposição à intervenção",
      "atrito e dados ausentes",
      "estimativa de efeito",
      "intervalo de incerteza",
      "efeitos adversos",
      "limitações e alternativas explicativas"
    ],
    "claimGate": "Sem baseline comparável, retenção tardia e forma alterada, o TERMO só pode relatar uso, experiência e desempenho observado; não ganho causal de aprendizagem."
  },
  "communication": {
    "optInDefault": false,
    "productWorksWithoutMessages": true,
    "quietHours": { "timezone": "America/Sao_Paulo", "startHour": 21, "endHour": 8 },
    "frequencyCaps": { "per24Hours": 1, "per7Days": 2 },
    "pauseDays": [30, 90],
    "unsubscribeWithoutLogin": true,
    "prohibitedPatterns": [
      "última chance",
      "agora ou nunca",
      "você perderá seus pontos",
      "não perca seus pontos",
      "sua sequência acaba",
      "suba no ranking"
    ]
  },
  "privacy": {
    "adminOutputAggregatedOnly": true,
    "minimumCellSize": 5,
    "forbiddenAdminFields": ["email", "user_id", "session_id", "answers", "feedback livre"],
    "ga4CanAwardPoints": false,
    "ga4CanSetMastery": false,
    "ga4ContainsLearningLedger": false
  }
